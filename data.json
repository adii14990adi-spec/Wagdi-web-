        },
        {
          "wagdi": "माने",
          "hindi": "मुझे",
          "english": "Me",
          "note": "कर्म कारक (Mujhe)"
        },
        {
          "wagdi": "माई",
          "hindi": "मैंने",
          "english": "I (Past)",
          "note": "कर्ता (Maine)"
        },
        {
          "wagdi": "मारु",
          "hindi": "मेरा / मेरी",
          "english": "My",
          "note": "सम्बन्ध (Mera/Meri)"
        },
        {
          "wagdi": "तू",
          "hindi": "तू",
          "english": "You",
          "note": "द्वितीय पुरुष (Tu)"
        },
        {
          "wagdi": "तन्ने",
          "hindi": "तुझे",
          "english": "You (Obj)",
          "note": "कर्म कारक (Tujhe)"
        },
        {
          "wagdi": "हु",
          "hindi": "हु / वह",
          "english": "He/She/It",
          "note": "अन्य पुरुष (Hu)"
        },
        {
          "wagdi": "आम्हा",
          "hindi": "हम",
          "english": "We",
          "note": "बहुवचन"
        }
      ],
      "notes": "वागड़ी में 'आम्हा' शब्द का प्रयोग 'हम' के लिए अधिक होता है। हिंदी से वागड़ी रूपांतरण नियम संलग्न हैं।"
